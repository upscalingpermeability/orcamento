# ─────────────────────────────────────────────────────────
# Boletim Orçamentário AEB — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# No Vercel, adicione estas variáveis em Settings → Environment Variables.
# ─────────────────────────────────────────────────────────

# API do Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# API do SendGrid (sendgrid.com — gratuito até 100 e-mails/dia)
SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# E-mail remetente verificado no SendGrid
FROM_EMAIL=boletim@aeb.gov.br
FROM_NAME=Boletim Orçamentário AEB

# Destinatários: email:Nome separados por vírgula
RECIPIENTS=joao@aeb.gov.br:João Silva,maria@aeb.gov.br:Maria Costa

# Temas monitorados (separados por vírgula)
TOPICS=LOA,LDO,PPA

# Segredo para autenticar o cron job do Vercel (qualquer string aleatória)
CRON_SECRET=gere-uma-string-aleatoria-aqui
